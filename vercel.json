{
  "crons": [
    {
      "path": "/api/v1/cron/send-notifications",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/v1/cron/send-email-digests",
      "schedule": "0 9 * * 1"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

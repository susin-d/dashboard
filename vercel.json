{
  "crons": [
    {
      "path": "/api/v1/cron/send-notifications",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/v1/cron/send-email-digests",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/v1/cron/purge-soft-deleted",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/v1/cron/send-calendar-reminders",
      "schedule": "*/15 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

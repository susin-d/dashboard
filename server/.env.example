APP_NAME=StarWaves API
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Firebase Cloud Firestore
FIREBASE_PROJECT_ID=your-firebase-project-id
FIRESTORE_DATABASE_ID=(default)
# Keep the JSON key outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\firebase-service-account.json
# Optional local emulator:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# GitHub OAuth App
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_STATE_SECRET=replace-with-a-long-random-secret
GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/api/v1/integrations/github/callback

# Google OAuth Web application with the Calendar API enabled.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=replace-with-a-different-long-random-secret
GOOGLE_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/api/v1/integrations/google-calendar/callback
GOOGLE_DRIVE_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/api/v1/integrations/google-drive/callback
FRONTEND_URL=http://127.0.0.1:5173
